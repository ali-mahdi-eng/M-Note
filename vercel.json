{
  "rewrites": [
    {
      "source": "/M-Note/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/M-Note/icons/(.*)",
      "destination": "/icons/$1"
    },
    {
      "source": "/M-Note/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/M-Note/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/M-Note/apple-touch-icon.png",
      "destination": "/apple-touch-icon.png"
    },
    {
      "source": "/M-Note",
      "destination": "/index.html"
    },
    {
      "source": "/M-Note/(.*)",
      "destination": "/index.html"
    }
  ]
}
